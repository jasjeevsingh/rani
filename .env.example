# RANI Environment Configuration Template
# Copy this file to .env.local and fill in your values
# DO NOT commit the actual .env.local file to git

# ============================================
# Firebase Configuration
# ============================================
# Get these values from Firebase Console > Project Settings > General > Your Apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Stripe Configuration
# ============================================
# Get these from Stripe Dashboard (https://dashboard.stripe.com)
# Use test keys (starting with sk_test_) for development
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PRICE_ID=price_YOUR_PRICE_ID_HERE

# ============================================
# Beta API Key Configuration (Optional)
# ============================================
# Only needed if you're providing a shared API key for beta testers
BETA_OPENAI_API_KEY=sk-proj-YOUR_BETA_KEY_HERE

# ============================================
# Ollama Configuration (Optional)
# ============================================
# Local Ollama server URL for embeddings and local AI
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Development Settings
# ============================================
# Set to 'development' for dev mode, 'production' for builds
NODE_ENV=development

# ============================================
# Application Configuration (Optional)
# ============================================
# Override default URLs if needed
RANI_API_URL=http://localhost:9001
RANI_WEB_URL=http://localhost:3000
RANI_DEBUG=false

# ============================================
# AI Provider API Keys (Optional - can be set in app settings)
# ============================================
# These can also be configured through the app's Settings UI
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ============================================
# Database Settings (Optional)
# ============================================
# Custom database path (optional - defaults to user data directory)
# DATABASE_PATH=/custom/path/to/database.db
