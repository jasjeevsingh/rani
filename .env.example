# RANI Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to git

# ============================================
# Firebase Configuration
# ============================================
# Get these values from Firebase Console > Project Settings > General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# Ollama Configuration (Optional)
# ============================================
# Local Ollama server URL for embeddings and local AI
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Development Settings
# ============================================
# Set to 'development' for dev mode, 'production' for builds
NODE_ENV=development

# ============================================
# AI Provider API Keys (Optional - can be set in app settings)
# ============================================
# These can also be configured through the app's Settings UI
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ============================================
# Database Settings (Optional)
# ============================================
# Custom database path (optional - defaults to user data directory)
# DATABASE_PATH=/custom/path/to/database.db
